# Amazing Marvin MCP server - all configuration variables, annotated.
#
# NOTE: the server does NOT read a .env file by itself (no dotenv
# dependency). Get these into the process environment instead:
#   - stdio mode: put them in the "env" block of your MCP client config
#     (see README), or `export` them before starting the client.
#   - shell:      set -a; source ./.env; set +a
#   - Docker:     docker run --env-file ./.env ...
#
# NEVER commit real values. Every *_FILE variant takes precedence over the
# plain variable and points at a file containing only the value (chmod 600).

# --- Marvin credentials (Amazing Marvin: Settings -> API / app.amazingmarvin.com/pre?api) ---

# Limited API token (required). Enough for most read tools and task creation.
MARVIN_API_TOKEN=
#MARVIN_API_TOKEN_FILE=/path/to/marvin-api-token

# Full Access token (optional but recommended - required by /doc* endpoints:
# update_task, set_priority, unmark_done, delete_task, category creation,
# time blocks, list_habits, reminders, reset_reward_points).
MARVIN_FULL_ACCESS_TOKEN=
#MARVIN_FULL_ACCESS_TOKEN_FILE=/path/to/marvin-full-access-token

# --- Transport ---

# stdio (default): run as a local command-based MCP server (Claude Desktop,
#                  Claude Code, etc.). No port, no auth needed.
# http:            Streamable HTTP server on HOST:PORT (path /mcp). Put a
#                  reverse proxy with TLS + real authentication in front of
#                  it before exposing it anywhere.
MCP_TRANSPORT=stdio
HOST=127.0.0.1
PORT=8787

# Bearer token required on every HTTP request (http mode only). Fail
# closed: without it the HTTP server refuses to start. Clients send it as
# "Authorization: Bearer <token>".
MCP_AUTH_TOKEN=
#MCP_AUTH_TOKEN_FILE=/path/to/mcp-auth-token

# Deliberately run the HTTP server WITHOUT authentication (e.g. a
# localhost experiment). Never expose such an instance beyond localhost.
#MCP_ALLOW_UNAUTHENTICATED=true

# --- Behavior ---

# IANA timezone for all date logic ("today", rate-limit rollover). Should
# match the timezone your Marvin account lives in. Defaults to the system
# timezone (which is UTC inside most containers).
MARVIN_TIMEZONE=Europe/Stockholm

# Directory for persisted state (the daily rate-limit counter).
# Default: ~/.marvin-mcp
#STATE_DIR=/data
